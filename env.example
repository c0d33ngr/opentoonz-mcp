# Copy to `.env` / export before running the server, or set these in your MCP
# client's environment block. All are optional if OpenToonz and tcomposer are
# already on PATH.

# Directory containing usr/bin/OpenToonz (an extracted AppImage root)
OPENTOONZ_RUNTIME=/home/you/.local/share/opentoonz-mcp/runtime/squashfs-root

# Or point at the binaries directly
# OPENTOONZ_BIN=/path/to/OpenToonz
# OPENTOONZ_TCOMPOSER_BIN=/path/to/tcomposer

# Where mutable state lives (shared stuff tree, isolated HOME, workspaces)
OPENTOONZ_MCP_HOME=/home/you/.local/share/opentoonz-mcp

# Shared OpenToonz TOONZROOT (defaults to <OPENTOONZ_MCP_HOME>/stuff)
# OPENTOONZ_STUFF=/path/to/stuff

# ffmpeg for opentoonz_render_video
OPENTOONZ_FFMPEG=ffmpeg

# Timeouts (seconds)
OPENTOONZ_SCRIPT_TIMEOUT=90
OPENTOONZ_RENDER_TIMEOUT=600

# Keep generated .toonzscript files as an audit trail
OPENTOONZ_KEEP_SCRIPTS=true
